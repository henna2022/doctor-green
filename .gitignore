# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (스크립트/노트북용 가상환경)
.venv/

# R / python junk (training)
training/.Rhistory
training/__pycache__/
training/dataset_sample/

# 2단계 분류 파이프라인/데이터 준비 산출물(대용량) — 커밋 금지.
# 스크립트 --out은 사용자 지정이 원칙이나, 레포 안 기본 경로로 쓸 때를 대비해 방어적으로 무시.
training/crops/
training/crops_*/
training/runs/
training/dataset/
training/_dl/
training/_accum/

# manual backups (keep on disk, do not track)
*.backup.docx
*.backup.pptx
